{
  "name": "@acr-js/marketplace",
  "version": "1.0.1",
  "description": "ACR Verified Plugin Marketplace & Skill Discovery MCP Server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "acr-marketplace": "./dist/index.js"
  },
  "files": [
    "dist/",
    ".claude/skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test:unit": "npx tsx --test test/reputation_ranking.test.ts test/ans_trust.test.ts",
    "test": "npm run typecheck && npm run test:unit",
    "prepublishOnly": "npm run build && npm run lint && npm run format:check"
  },
  "keywords": [
    "acr",
    "agentic-chat-rooms",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "plugins",
    "skills",
    "marketplace",
    "ans",
    "did",
    "typescript"
  ],
  "author": "@acr-js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agentic-Chat-Rooms-Protocol/acr-marketplace.git"
  },
  "homepage": "https://github.com/Agentic-Chat-Rooms-Protocol/acr-marketplace#readme",
  "bugs": {
    "url": "https://github.com/Agentic-Chat-Rooms-Protocol/acr-marketplace/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "fast-xml-parser": "^4.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "semantic-release": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  }
}
